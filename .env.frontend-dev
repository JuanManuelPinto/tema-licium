# Private image published by the flavors pipeline.
FRONTEND_DEV_IMAGE=registry.gitlab.com/licium/ci-cd/flavors/frontend-dev:glam-base

# Use an absolute path. On Windows prefer forward slashes, for example:
# THEME_SOURCE_DIR=C:/Users/alumno/work/my-theme
THEME_SOURCE_DIR=C:/libnamic/licium-gadir

# Mount only one theme directory so the image keeps the rest of the base themes.
THEME_TARGET_KIND=site
THEME_TARGET_SLUG=licium-gadir

FRONTEND_DEV_PORT=3000
NUXT_PUBLIC_API_BASE=/api
NUXT_API_BASE_INTERNAL=/api
NUXT_API_PROXY_TARGET=https://arcadium.cluster24.libnamic.eu/api
NUXT_ALLOWED_HOSTS=localhost,127.0.0.1
CHOKIDAR_USEPOLLING=1
CHOKIDAR_INTERVAL=300
NODE_OPTIONS=--max-old-space-size=8192
